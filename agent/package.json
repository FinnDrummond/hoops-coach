{
  "name": "chert-student-agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.23.2 || ^24.0.0 || ^26.0.0"
  },
  "scripts": {
    "start": "node --env-file=.env.local agent.mjs start",
    "check": "node --check agent.mjs && node --check greet.mjs && node --check chert-rooms.mjs && node --check pose.mjs",
    "help": "node agent.mjs --help",
    "texts": "node --env-file=.env.local texts.mjs",
    "pose:model": "mkdir -p models && curl -fL -o models/movenet-thunder.onnx https://huggingface.co/Xenova/movenet-singlepose-thunder/resolve/main/onnx/model.onnx",
    "pose:test": "node pose-test.mjs"
  },
  "dependencies": {
    "@livekit/agents": "1.8.0",
    "@livekit/agents-plugin-openai": "1.8.0",
    "@livekit/rtc-node": "0.13.35",
    "jpeg-js": "^0.4.4",
    "onnxruntime-node": "^1.31.1",
    "zod": "4.6.7"
  }
}
